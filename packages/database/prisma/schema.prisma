datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  COMMERCIAL
  FINANCIAL
  OPERATOR
  BOT_SERVICE
}

enum ChannelSource {
  WEB
  DESKTOP
  MOBILE
  WHATSAPP
  TELEGRAM
  API_INTEGRATION
}

enum PartyType {
  INDIVIDUAL // Pessoa Física
  COMPANY    // Pessoa Jurídica
}

enum RawMaterialCategory {
  PAPER       // Papéis (Couché, Offset, Duplex, etc.)
  VINYL       // Lonas e Vinis adesivos
  INK         // Tintas, toners
  PLATE       // Chapas offset, matrizes
  FINISHING   // Vernizes, ribbons, bobinas de laminação
  CONSUMABLE  // Estopa, solventes, fita dupla face
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum WorkOrderStatus {
  PENDING
  PRE_PRESS
  PRINTING
  FINISHING
  QUALITY_CONTROL
  READY_FOR_PICKUP
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

// -------------------------------------------------------------
// USUÁRIOS E AUTENTICAÇÃO
// -------------------------------------------------------------
model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  passwordHash           String?
  role                   Role      @default(OPERATOR)
  isActive               Boolean   @default(true)
  isRoot                 Boolean   @default(false)
  emailVerified          Boolean   @default(false)
  activationToken        String?   @unique
  activationTokenExpires DateTime?
  resetPasswordToken     String?   @unique
  resetPasswordExpires   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  quotes        Quote[]
  workOrders    WorkOrder[]
  stageLogs     StageExecutionLog[]

  @@map("users")
}

// -------------------------------------------------------------
// CLIENTES E FORNECEDORES
// -------------------------------------------------------------
model Party {
  id            String        @id @default(uuid())
  type          PartyType     @default(INDIVIDUAL)
  name          String        // Razão Social ou Nome Completo
  tradeName     String?       // Nome Fantasia
  document      String        @unique // CPF ou CNPJ (apenas dígitos)
  email         String?
  phone         String        // Obrigatório para identificação em chatbots
  address       String?
  city          String?
  state         String?
  isCustomer    Boolean       @default(true)
  isSupplier    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  quotes        Quote[]
  workOrders    WorkOrder[]
  operatingExpenses OperatingExpense[]
  receivables   Receivable[]

  @@map("parties")
}

// -------------------------------------------------------------
// INSUMOS & MATÉRIAS-PRIMAS
// -------------------------------------------------------------
model RawMaterial {
  id             String              @id @default(uuid())
  name           String
  category       RawMaterialCategory
  unitOfMeasure  String              // UN, KG, M2, FL (Folha), ML (Metro linear)
  costPerUnit    Decimal             @db.Decimal(12, 4)
  currentStock   Decimal             @default(0) @db.Decimal(12, 4)
  minStock       Decimal             @default(0) @db.Decimal(12, 4)
  
  // Propriedades físicas (especialmente para papel e substratos planos)
  sheetWidthMm   Int?                // Ex: 660 mm
  sheetHeightMm  Int?                // Ex: 960 mm
  grammage       Int?                // Ex: 150 gsm

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  stockMovements StockMovement[]
  quoteItems     QuoteItem[]
  productTemplates ProductTemplate[]

  @@map("raw_materials")
}

model StockMovement {
  id             String       @id @default(uuid())
  rawMaterialId  String
  workOrderId    String?
  quantity       Decimal      @db.Decimal(12, 4) // Positivo (entrada), Negativo (saída)
  reason         String       // "CONSUMO_PRODUCAO", "COMPRA", "PERDA_PRODUCAO", "AJUSTE"
  createdAt      DateTime     @default(now())

  rawMaterial    RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id])

  @@map("stock_movements")
}

// -------------------------------------------------------------
// MÁQUINAS
// -------------------------------------------------------------
model Machine {
  id            String       @id @default(uuid())
  name          String       // Ex: Heidelberg Speedmaster, Konica Minolta C3070
  hourlyRate    Decimal      @db.Decimal(10, 2) // Custo por hora de máquina
  setupMinutes  Int          @default(15)       // Tempo médio de setup
  maxSheetsHour Int?         // Velocidade nominal por hora
  isActive      Boolean      @default(true)

  stageLogs     StageExecutionLog[]
  productTemplates ProductTemplate[]

  @@map("machines")
}

// -------------------------------------------------------------
// ORÇAMENTOS (QUOTES)
// -------------------------------------------------------------
model Quote {
  id              String         @id @default(uuid())
  code            Int            @default(autoincrement()) // Ex: 1001
  partyId         String
  userId          String         // Vendedor ou BOT_SERVICE
  status          QuoteStatus    @default(DRAFT)
  origin          ChannelSource  @default(WEB)
  totalCost       Decimal        @db.Decimal(12, 2)
  markupApplied   Decimal        @db.Decimal(6, 3) // Ex: 0.40 para 40%
  totalAmount     Decimal        @db.Decimal(12, 2) // Preço de venda ao cliente
  validUntil      DateTime
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  party           Party          @relation(fields: [partyId], references: [id])
  user            User           @relation(fields: [userId], references: [id])
  items           QuoteItem[]
  workOrder       WorkOrder?

  @@map("quotes")
}

model QuoteItem {
  id                   String       @id @default(uuid())
  quoteId              String
  rawMaterialId        String?
  productName          String       // Ex: Cartão de Visita, Folder A4 2 Dobras
  quantity             Int
  widthMm              Int          // Formato aberto (largura)
  heightMm             Int          // Formato aberto (altura)
  colorsFront          Int          // Ex: 4
  colorsBack           Int          // Ex: 4 (4x4) ou 0 (4x0)
  finishingOptions     Json         // Array de acabamentos: ["LAMINACAO_FOSCA", "CORTE_VINCO"]
  
  // Resultados do cálculo técnico
  sheetsRequired       Int
  itemsPerSheet        Int
  paperCostCalculated  Decimal      @db.Decimal(10, 2)
  finishingCostTotal   Decimal      @db.Decimal(10, 2)
  machineCostTotal     Decimal      @db.Decimal(10, 2)
  unitPrice            Decimal      @db.Decimal(10, 4)
  itemTotalAmount      Decimal      @db.Decimal(12, 2)

  quote                Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rawMaterial          RawMaterial? @relation(fields: [rawMaterialId], references: [id])

  @@map("quote_items")
}

// -------------------------------------------------------------
// ORDENS DE SERVIÇO (CHÃO DE FÁBRICA)
// -------------------------------------------------------------
model WorkOrder {
  id              String           @id @default(uuid())
  orderNumber     String           @unique // Ex: "OS-2026-00042"
  quoteId         String           @unique
  partyId         String
  userId          String           // Criador da OS
  origin          ChannelSource    @default(WEB)
  status          WorkOrderStatus  @default(PENDING)
  priority        Int              @default(1) // 1: Baixa, 2: Normal, 3: Alta, 4: Urgente
  deliveryDate    DateTime
  fileUrl         String?          // Link do PDF/arte validada
  barcode         String           @unique // Gerado para leitura rápida no chão de fábrica
  totalAmount     Decimal          @db.Decimal(12, 2)
  paymentStatus   PaymentStatus    @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  quote           Quote            @relation(fields: [quoteId], references: [id])
  party           Party            @relation(fields: [partyId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  stages          WorkOrderStage[]
  stockMovements  StockMovement[]
  receivables     Receivable[]

  @@map("work_orders")
}

model WorkOrderStage {
  id              String              @id @default(uuid())
  workOrderId     String
  stepOrder       Int                 // 1: Pré-impressão, 2: Impressão, 3: Acabamento, etc.
  name            String              // Nome da etapa
  status          StageStatus         @default(PENDING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  workOrder       WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  logs            StageExecutionLog[]

  @@unique([workOrderId, stepOrder])
  @@map("work_order_stages")
}

model StageExecutionLog {
  id              String          @id @default(uuid())
  stageId         String
  operatorId      String
  machineId       String?
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  wasteQuantity   Int             @default(0) // Quantidade de folhas/peças perdidas
  notes           String?

  stage           WorkOrderStage  @relation(fields: [stageId], references: [id])
  operator        User            @relation(fields: [operatorId], references: [id])
  machine         Machine?        @relation(fields: [machineId], references: [id])

  @@map("stage_execution_logs")
}

// -------------------------------------------------------------
// COLABORADORES & RH (CHÃO DE FÁBRICA E ADMINISTRAÇÃO)
// -------------------------------------------------------------
enum EmployeeDepartment {
  PRE_PRESS        // Pré-impressão & CTP
  PRINTING         // Impressão (Offset / Digital / Plotter)
  FINISHING        // Acabamento, Corte e Dobra
  QUALITY          // Controle de Qualidade
  EXPEDITION       // Expedição e Logística
  COMMERCIAL       // Comercial e Atendimento
  ADMINISTRATIVE   // Administrativo e Financeiro
  MAINTENANCE      // Manutenção Mecânica e Elétrica
}

enum EmployeeStatus {
  ACTIVE           // Ativo
  ON_LEAVE         // Férias / Licença
  INACTIVE         // Inativo / Desligado
}

enum WorkShift {
  MORNING          // Manhã (06h - 14h)
  AFTERNOON        // Tarde (14h - 22h)
  NIGHT            // Noite (22h - 06h)
  COMMERCIAL_HOURS // Horário Comercial (08h - 18h)
}

model Employee {
  id             String              @id @default(uuid())
  name           String
  document       String              @unique // CPF
  registration   String?             @unique // Matrícula interna da gráfica (ex: "OP-012")
  role           String              // Cargo (ex: "Operador Offset Plana", "Guilhotineiro", "Arte-Finalista CTP")
  department     EmployeeDepartment  @default(PRINTING)
  shift          WorkShift           @default(COMMERCIAL_HOURS)
  status         EmployeeStatus      @default(ACTIVE)
  email          String?
  phone          String              // Contato direto / WhatsApp
  hireDate       DateTime            @default(now())
  hourlyRate     Decimal?            @db.Decimal(10, 2) // Custo/hora de mão de obra direta (R$/h)
  monthlySalary  Decimal?            @db.Decimal(10, 2)
  notes          String?             // Habilitações, treinamentos em máquinas, etc.
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@map("employees")
}

// -------------------------------------------------------------
// DESPESAS OPERACIONAIS (OPEX)
// -------------------------------------------------------------
enum ExpenseCategory {
  RENT_FACILITIES       // Aluguel, IPTU, Condomínio Predial
  UTILITIES             // Energia Elétrica Predial, Água, Gás, Telefonia/Internet
  SOFTWARE_LICENSES     // Assinaturas Adobe CC, Softwares RIP, Antivírus, Hospedagem
  OFFICE_ADMINISTRATIVE // Contabilidade, Jurídico, Material de Escritório, Limpeza/Copa
  COMMERCIAL_MARKETING  // Anúncios, Mostruários de Papéis, Catálogos, Divulgação
  MAINTENANCE_PREDIAL   // Manutenção predial, compressores de ar, elétrica geral
  FINANCIAL_TAXES       // Tarifas bancárias, taxas de boletos, licenças de bombeiros (AVCB)
  OTHER                 // Outras despesas operacionais avulsas
}

enum ExpenseType {
  FIXED                 // Despesa Fixa (ex: Aluguel, Internet, Softwares)
  VARIABLE              // Despesa Variável (ex: Energia Elétrica, Manutenção)
}

enum PaymentMethod {
  BOLETO                // Boleto Bancário
  PIX                   // PIX
  BANK_TRANSFER         // Transferência / TED / DOC
  CREDIT_CARD           // Cartão de Crédito
  DEBIT_CARD            // Cartão de Débito
  CASH                  // Dinheiro em Espécie
  AUTO_DEBIT            // Débito Automático em Conta
}

model OperatingExpense {
  id                  String           @id @default(uuid())
  description         String
  category            ExpenseCategory
  expenseType         ExpenseType      @default(FIXED)
  amount              Decimal          @db.Decimal(12, 2)
  dueDate             DateTime
  paidAt              DateTime?
  status              PaymentStatus    @default(PENDING)
  paymentMethod       PaymentMethod?
  competenceDate      DateTime         // Mês e ano a que se refere a despesa
  supplierId          String?          // Fornecedor opcional cadastrado
  beneficiaryName     String?          // Nome do credor avulso (ex: CEMIG, Imobiliária Central)
  barcode             String?          // Linha digitável ou código PIX
  documentNumber      String?          // NF de serviço / Fatura / Recibo
  isRecurring         Boolean          @default(false)
  recurrenceInterval  String?          @default("MONTHLY") // MONTHLY, YEARLY
  recurrenceEndDate   DateTime?        // Fim da recorrência ou data limite de renovação
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  supplier            Party?           @relation(fields: [supplierId], references: [id])

  @@index([competenceDate])
  @@index([dueDate])
  @@index([status])
  @@index([category])
  @@index([supplierId])
  @@map("operating_expenses")
}

// -------------------------------------------------------------
// CONTAS A RECEBER (RECEIVABLES)
// -------------------------------------------------------------
model Receivable {
  id                 String         @id @default(uuid())
  workOrderId        String?        // Vinculado a uma OS ou avulso
  partyId            String         // Cliente sacado
  description        String         // Ex: "Sinal 50% - OS-2026-00042", "Parcela 1/3"
  installmentNumber  Int            @default(1)
  totalInstallments  Int            @default(1)
  amount             Decimal        @db.Decimal(12, 2)
  dueDate            DateTime
  paidAt             DateTime?
  status             PaymentStatus  @default(PENDING)
  paymentMethod      PaymentMethod?
  barcode            String?        // Código PIX Copia-e-Cola ou linha digitável
  documentNumber     String?        // NF / Recibo
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  workOrder          WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  party              Party          @relation(fields: [partyId], references: [id])

  @@index([status])
  @@index([dueDate])
  @@index([partyId])
  @@index([workOrderId])
  @@map("receivables")
}

// -------------------------------------------------------------
// MODELOS RÁPIDOS / PRODUTOS TABELADOS DE BALCÃO
// -------------------------------------------------------------
model ProductTemplate {
  id                   String        @id @default(uuid())
  name                 String        // Ex: "Cartão de Visita 4x4 Couchê 300g"
  category             String        @default("Papelaria") // "Papelaria", "Promocional", "Comunicação Visual"
  description          String?
  defaultWidthMm       Int           // Formato aberto (largura)
  defaultHeightMm      Int           // Formato aberto (altura)
  defaultColorsFront   Int           @default(4)
  defaultColorsBack    Int           @default(4)
  defaultFinishing     Json          @default("[]") // ex: ["LAMINACAO_FOSCA", "VERNIZ_LOCALIZADO"]
  defaultRawMaterialId String?
  defaultMachineId     String?
  defaultMarkupPercent Decimal       @default(35) @db.Decimal(5, 2)
  suggestedQuantities  Json          @default("[500, 1000, 2500, 5000]")
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  rawMaterial          RawMaterial?  @relation(fields: [defaultRawMaterialId], references: [id], onDelete: SetNull)
  machine              Machine?      @relation(fields: [defaultMachineId], references: [id], onDelete: SetNull)

  @@map("product_templates")
}

