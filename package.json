{
  "name": "erp-grafica",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:start": "node scripts/start-db.js",
    "db:seed": "pnpm --filter @erp/database db:seed",
    "db:dump": "pnpm --filter @erp/database exec tsx prisma/dump.ts",
    "db:restore": "pnpm --filter @erp/database exec tsx prisma/restore.ts",
    "db:generate": "pnpm --filter @erp/database db:generate",
    "db:migrate": "pnpm --filter @erp/database db:migrate",
    "db:studio": "pnpm --filter @erp/database db:studio"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^25.12.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.5.1"
}
